{
  "name": "@tronhooks/mcp",
  "version": "0.1.0",
  "description": "Local MCP for TRON USDT/TRX transfer notifications: read watches/events and prepare owner-confirmed configuration at tronhooks.com.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tronhooks-mcp": "dist/cli.js"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://tronhooks.com/docs/ai/clients/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LuganBI/tronhooks-mcp.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit && tsup src/index.ts src/cli.ts --format esm --clean",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "keywords": [
    "mcp",
    "tron",
    "usdt",
    "webhook",
    "telegram",
    "claude-code",
    "gemini-cli",
    "codex"
  ]
}
